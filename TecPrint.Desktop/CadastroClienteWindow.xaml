<Window x:Class="TecPrint.Desktop.CadastroClienteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Cadastrar Cliente - TecPrint" Height="400" Width="400" WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <StackPanel>
            <TextBlock Text="Cadastrar Cliente" FontSize="20" FontWeight="Bold" Margin="0,0,0,24" HorizontalAlignment="Center" />

            <TextBlock Text="Nome completo:" FontWeight="SemiBold" Margin="0,4,0,0" />
            <TextBox x:Name="TxtNome" />

            <TextBlock Text="Telefone:" FontWeight="SemiBold" Margin="0,12,0,0" />
            <TextBox x:Name="TxtTelefone" />

            <TextBlock Text="Endereço:" FontWeight="SemiBold" Margin="0,12,0,0" />
            <TextBox x:Name="TxtEndereco" />

            <TextBlock Text="Documento (CPF/CNPJ):" FontWeight="SemiBold" Margin="0,12,0,0" />
            <TextBox x:Name="TxtDocumento" />

            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                <Button Content="Cadastrar" Click="BtnCadastrar_Click" Background="#1e8449" BorderThickness="0" Foreground="White" Width="100" Margin="0,0,8,0" />
                <Button Content="Cancelar" Click="BtnCancelar_Click" Background="#7f8c8d" BorderThickness="0" Foreground="White" Width="100" />
            </StackPanel>

            <TextBlock x:Name="TxtErro" Foreground="Red" Margin="0,12,0,0" TextWrapping="Wrap" />
            <TextBlock x:Name="TxtSucesso" Foreground="Green" Margin="0,12,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>
