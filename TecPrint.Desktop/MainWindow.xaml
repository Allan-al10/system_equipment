<Window x:Class="TecPrint.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="TecPrint - Sistema de OS (Desktop)" Height="700" Width="1000">
    <Grid Margin="16">
        <!-- Painel de Login -->
        <StackPanel x:Name="PainelLogin" HorizontalAlignment="Center" VerticalAlignment="Center" Width="360">
            <TextBlock Text="TecPrint - Login" FontSize="22" FontWeight="Bold" Margin="0,0,0,24" HorizontalAlignment="Center" />
            <TextBlock Text="Usuário (e-mail):" FontWeight="SemiBold" />
            <TextBox x:Name="TxtEmail" Text="admin@tecprint.com" />
            <TextBlock Text="Senha:" FontWeight="SemiBold" Margin="0,8,0,0" />
            <PasswordBox x:Name="TxtSenha" Password="admin123" />
            <Button Content="Entrar" Click="BtnLogin_Click" Margin="0,16,0,0" Background="#1a5276" BorderThickness="0" Foreground="White" />
            <TextBlock x:Name="TxtErroLogin" Foreground="Red" Margin="0,12,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Painel Principal (após login) -->
        <Grid x:Name="PainelPrincipal" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="TecPrint - Desktop" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock x:Name="TxtUsuarioLogado" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#1a5276" FontWeight="SemiBold" />
                <Button Content="Sair" Click="BtnSair_Click" HorizontalAlignment="Right" Background="#c0392b" BorderThickness="0" Foreground="White" Width="70" />
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Ordens de Serviço" FontSize="18" FontWeight="Bold" Margin="0,0,0,12" />
                    <Button Content="Atualizar lista" Click="BtnAtualizar_Click" Margin="0,0,0,12" Background="#1e8449" BorderThickness="0" Foreground="White" />
                    <DataGrid x:Name="GridOrdens" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionChanged="GridOrdens_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nº OS" Binding="{Binding NumeroOS}" Width="100" />
                            <DataGridTextColumn Header="Cliente" Binding="{Binding ClienteNome}" Width="*" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" />
                            <DataGridTextColumn Header="Abertura" Binding="{Binding DataAbertura, StringFormat=dd/MM/yyyy}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Content="Nova OS" Click="BtnNovaOs_Click" Margin="0,12,0,0" Background="#1a5276" BorderThickness="0" Foreground="White" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock Text="Detalhes" FontSize="18" FontWeight="Bold" Margin="0,0,0,12" />
                    <TextBlock x:Name="TxtDetalheNumero" FontWeight="Bold" FontSize="16" Foreground="#1a5276" />
                    <TextBlock x:Name="TxtDetalheCliente" />
                    <TextBlock x:Name="TxtDetalheEquipamento" />
                    <TextBlock x:Name="TxtDetalheDescricao" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <TextBlock x:Name="TxtDetalheStatus" FontWeight="SemiBold" Margin="0,12,0,0" />
                    <TextBlock x:Name="TxtDetalheValor" Margin="0,4,0,0" />

                    <StackPanel Margin="0,16,0,0">
                        <TextBlock Text="Novo status:" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ComboBox x:Name="CmbNovoStatus">
                            <ComboBoxItem Content="Orçamento" />
                            <ComboBoxItem Content="Aguardando Aprovação" />
                            <ComboBoxItem Content="Reparo" />
                            <ComboBoxItem Content="Pronto" />
                            <ComboBoxItem Content="Entregue" />
                            <ComboBoxItem Content="Cancelado" />
                        </ComboBox>
                        <Button Content="Atualizar status" Click="BtnAtualizarStatus_Click" Margin="0,8,0,0" Background="#f39c12" BorderThickness="0" Foreground="White" />
                    </StackPanel>

                    <StackPanel Margin="0,16,0,0">
                        <TextBlock Text="Registro / Anotação:" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBox x:Name="TxtNovoRegistro" Height="80" TextWrapping="Wrap" AcceptsReturn="True" />
                        <Button Content="Adicionar registro" Click="BtnAdicionarRegistro_Click" Margin="0,8,0,0" Background="#1a5276" BorderThickness="0" Foreground="White" />
                    </StackPanel>

                    <TextBlock x:Name="TxtMensagem" Foreground="Green" Margin="0,12,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
