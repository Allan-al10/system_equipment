<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TecPrint - Sistema de OS</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; background: #f5f5f5; color: #333; font-size: 16px; line-height: 1.5; }
        header { background: #1a5276; color: #fff; padding: 14px 16px; position: sticky; top: 0; z-index: 100; }
        header h1 { font-size: 18px; }
        header a { color: #ffeaa7; text-decoration: none; margin-right: 16px; font-size: 15px; }
        header a:hover { text-decoration: underline; }
        main { padding: 16px; max-width: 900px; margin: 0 auto; }
        .card { background: #fff; border-radius: 10px; padding: 16px; margin-bottom: 16px; box-shadow: 0 2px 6px rgba(0,0,0,0.08); }
        .card h2 { font-size: 18px; margin-bottom: 12px; color: #1a5276; border-bottom: 2px solid #1a5276; padding-bottom: 6px; }
        table { width: 100%; border-collapse: collapse; margin-top: 10px; }
        th, td { text-align: left; padding: 10px 8px; border-bottom: 1px solid #ddd; font-size: 14px; }
        th { background: #eef2f7; color: #1a5276; font-size: 13px; text-transform: uppercase; }
        tr:hover { background: #f9f9f9; }
        .btn { display: inline-block; background: #1a5276; color: #fff; border: none; padding: 10px 16px; border-radius: 6px; cursor: pointer; font-size: 14px; text-decoration: none; margin: 4px 4px 4px 0; }
        .btn:hover { background: #144263; }
        .btn-success { background: #1e8449; }
        .btn-success:hover { background: #166a37; }
        .btn-danger { background: #c0392b; }
        .btn-danger:hover { background: #962d22; }
        .btn-sm { padding: 6px 10px; font-size: 13px; }
        input, select, textarea { width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 6px; font-size: 15px; margin: 6px 0 12px 0; }
        label { font-size: 14px; font-weight: 600; margin-bottom: 4px; display: block; }
        .msg-erro { color: #c0392b; font-size: 13px; margin-bottom: 10px; }
        .msg-sucesso { color: #1e8449; font-size: 14px; margin-bottom: 12px; }
        .badge { display: inline-block; padding: 4px 8px; border-radius: 4px; font-size: 12px; font-weight: bold; color: #fff; }
        .bg-recebido { background: #3498db; }
        .bg-orcamento { background: #f39c12; }
        .bg-aguardandoaprovacao { background: #e67e22; }
        .bg-reparo { background: #9b59b6; }
        .bg-pronto { background: #27ae60; }
        .bg-entregue { background: #1e8449; }
        .bg-cancelado { background: #7f8c8d; }
        .flex { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin-bottom: 12px; }
        .badge-status { font-size: 12px; padding: 3px 8px; border-radius: 12px; color: #fff; display: inline-block; width: fit-content; }
        .form-row { display: grid; grid-template-columns: 1fr; gap: 10px; }
        @@media (min-width: 600px) { .form-row { grid-template-columns: 1fr 1fr; } }
        footer { padding: 20px; text-align: center; color: #777; font-size: 13px; border-top: 1px solid #ddd; }
    </style>
</head>
<body>
    <header>
        <h1>🖨️ TecPrint</h1>
        <a href="@Url.Action("Index", "Ordens")">Ordens de Serviço</a>
        @if (User.Identity!.IsAuthenticated)
        {
            <span style="color:#ffeaa7;font-size:13px;">@User.Identity.Name (@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value)</span>
            <a href="@Url.Action("Logout", "Account")" style="color:#ffeaa7;">Sair</a>
        }
        else
        {
            <a href="@Url.Action("Login", "Account")" style="color:#ffeaa7;">Entrar</a>
        }
    </header>

    <main>
        @RenderBody()
    </main>

    <footer>
        TecPrint &copy; 2026 - Sistema local de ordens de serviço
    </footer>
</body>
</html>
